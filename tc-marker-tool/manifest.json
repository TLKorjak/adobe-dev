{
  "manifestVersion": 5,
  "id": "tv.promots.tc-markers",
  "name": "TC Markers",
  "version": "0.1.0",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6"
  },
  "main": "index.html",
  "entrypoints": [
    {
      "type": "panel",
      "id": "main",
      "label": "TC Markers",
      "minimumSize": { "width": 300, "height": 260 },
      "preferredDockedSize": { "width": 360, "height": 440 }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess"
  },
  "icons": [
    { "width": 24, "height": 24, "path": "icons/icon-24.png", "scale": [1, 2], "theme": ["darkest", "dark", "light", "lightest", "all"], "species": ["chrome", "generic"] },
    { "width": 48, "height": 48, "path": "icons/icon-48.png", "scale": [1, 2], "theme": ["darkest", "dark", "light", "lightest", "all"], "species": ["chrome", "generic"] }
  ]
}
